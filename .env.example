NODE_ENV=development
PORT=3000
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://yard:YOUR_PASSWORD@127.0.0.1:3306/yardhrms
REDIS_URL=redis://127.0.0.1:6379
FIELD_ENCRYPTION_KEY=
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
HRMS_URL=http://localhost:5173
QWIK_URL=http://localhost:5174
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=YardHRMS <no-reply@localhost>
SESSION_IDLE_MINUTES=30
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=yardhrms-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Keep migration credentials separate from production application/worker secrets.
MIGRATION_DATABASE_URL=
MYSQL_SSL=false
# Set MYSQL_SSL=true with a trusted CA for production connections.
MYSQL_SSL_CA=

# Uploads remain quarantined unless a real ClamAV INSTREAM scanner returns CLEAN.
CLAMAV_HOST=
CLAMAV_PORT=3310

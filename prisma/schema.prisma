generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Char(36)
  email String @unique @db.VarChar(191)
  name String @db.VarChar(191)
  passwordHash String @db.VarChar(255)
  verifiedAt DateTime?
  mfaSecret String? @db.Text
  mfaEnabled Boolean @default(false)
  platformRole String? @db.VarChar(32)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  tokens AuthToken[]
}
model AuthToken {
  id String @id @default(uuid()) @db.Char(36)
  hash String @unique @db.Char(64)
  kind String @db.VarChar(32)
  userId String @db.Char(36)
  user User @relation(fields:[userId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  tenantId String? @db.Char(36)
  roleName String? @db.VarChar(64)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
}
model Session {
  id String @id @default(uuid()) @db.Char(36)
  tokenHash String @unique @db.Char(64)
  csrfHash String @db.Char(64)
  userId String @db.Char(36)
  user User @relation(fields:[userId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  tenantId String? @db.Char(36)
  mfaVerified Boolean @default(false)
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model Tenant {
  id String @id @default(uuid()) @db.Char(36)
  legalName String @db.VarChar(191)
  displayName String @db.VarChar(191)
  slug String @unique @db.VarChar(100)
  timezone String @default("America/Jamaica") @db.VarChar(64)
  locale String @default("en-JM") @db.VarChar(16)
  logoUrl String? @db.VarChar(500)
  accentColor String @default("#1b6b58") @db.VarChar(7)
  address String? @db.Text
  contactEmail String? @db.VarChar(191)
  companyIdentifiers String? @db.Text
  monthlyStandardHours Decimal @default(173.33) @db.Decimal(8,2)
  allowSelfApproval Boolean @default(false)
  status String @default("ACTIVE") @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  roles Role[]
  employees Employee[]
  departments Department[]
  configurationChanges ConfigurationChange[]
  references ReferenceData[]
  holidays Holiday[]
  leaveTypes LeaveType[]
  leaveRequests LeaveRequest[]
  leaveLedger LeaveLedger[]
  timesheets Timesheet[]
  overtime Overtime[]
  rules StatutoryRule[]
  payrollRuns PayrollRun[]
  snapshots PayrollSnapshot[]
  imports ImportBatch[]
  legacyMaps LegacyMap[]
  reportJobs ReportJob[]
  files PrivateFile[]
  audits AuditEvent[]
  subscription Subscription?
  license License?
  payments ManualPayment[]
  subscriptionEvents SubscriptionEvent[]
}
model Permission {
  code String @id @db.VarChar(100)
  roles RolePermission[]
}
model Role {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  name String @db.VarChar(64)
  approvalScope String @default("TENANT") @db.VarChar(16)
  permissions RolePermission[]
  assignments MembershipRole[]
  @@unique([tenantId,id])
  @@unique([tenantId,name])
}
model RolePermission {
  roleId String @db.Char(36)
  permissionCode String @db.VarChar(100)
  role Role @relation(fields:[roleId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  permission Permission @relation(fields:[permissionCode], references:[code],onDelete:Restrict,onUpdate:Cascade)
  @@id([roleId,permissionCode])
}
model Membership {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  userId String @db.Char(36)
  user User @relation(fields:[userId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  active Boolean @default(true)
  employeeId String? @db.Char(36)
  employee Employee? @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  roles MembershipRole[]
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,userId])
}
model MembershipRole {
  tenantId String @db.Char(36)
  membershipId String @db.Char(36)
  roleId String @db.Char(36)
  membership Membership @relation(fields:[tenantId,membershipId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  role Role @relation(fields:[tenantId,roleId], references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  @@id([tenantId,membershipId,roleId])
  @@index([tenantId,roleId])
}
model Department {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  name String @db.VarChar(100)
  employees Employee[]
  @@unique([tenantId,id])
  @@unique([tenantId,name])
}
model ReferenceData {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  category String @db.VarChar(50)
  name String @db.VarChar(100)
  configuration Json?
  active Boolean @default(true)
  scheduleEmployees Employee[] @relation("EmployeeSchedule")
  @@unique([tenantId,id])
  @@unique([tenantId,category,name])
}
model Holiday {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  date DateTime @db.Date
  name String @db.VarChar(100)
  @@unique([tenantId,date])
}
model Employee {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId], references:[id],onDelete:Restrict,onUpdate:Cascade)
  employeeNumber String @db.VarChar(64)
  firstName String @db.VarChar(100)
  lastName String @db.VarChar(100)
  email String? @db.VarChar(191)
  phone String? @db.VarChar(50)
  address String? @db.Text
  parish String? @db.VarChar(64)
  gender String? @db.VarChar(32)
  dateOfBirth DateTime? @db.Date
  departmentId String? @db.Char(36)
  department Department? @relation(fields:[tenantId,departmentId], references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  scheduleId String? @db.Char(36)
  schedule ReferenceData? @relation("EmployeeSchedule",fields:[tenantId,scheduleId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  position String? @db.VarChar(100)
  branch String? @db.VarChar(100)
  employmentType String @default("Permanent") @db.VarChar(64)
  managerId String? @db.Char(36)
  manager Employee? @relation("EmployeeManager",fields:[tenantId,managerId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  reports Employee[] @relation("EmployeeManager")
  hireDate DateTime @db.Date
  probationDate DateTime? @db.Date
  confirmationDate DateTime? @db.Date
  terminationDate DateTime? @db.Date
  frequency String @db.VarChar(16)
  payType String @default("SALARY") @db.VarChar(16)
  basePay Decimal @db.Decimal(18,2)
  standardHours Decimal @db.Decimal(8,2)
  compensationConfigured Boolean @default(false)
  overtimeEligible Boolean @default(false)
  sensitiveCipher String? @db.Text
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  bankAccounts EmployeeBankAccount[]
  emergencyContacts EmergencyContact[]
  compensation CompensationHistory[]
  leaveRequests LeaveRequest[]
  ledger LeaveLedger[]
  timesheets Timesheet[]
  overtime Overtime[]
  snapshots PayrollSnapshot[]
  files PrivateFile[]
  adjustments PayrollAdjustment[]
  @@unique([tenantId,id])
  @@unique([tenantId,employeeNumber])
  @@index([tenantId,active,frequency])
}
model EmergencyContact {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId], references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  name String @db.VarChar(191)
  relationship String @db.VarChar(64)
  phone String @db.VarChar(50)
}
model CompensationHistory {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  effectiveDate DateTime @db.Date
  basePay Decimal @db.Decimal(18,2)
  frequency String @db.VarChar(16)
  payType String @db.VarChar(16)
  standardHours Decimal @db.Decimal(8,2)
  reason String @db.Text
  actorId String @db.Char(36)
  createdAt DateTime @default(now())
  @@index([tenantId,employeeId,effectiveDate])
}
model LeaveType {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  name String @db.VarChar(64)
  paidFraction Decimal @default(1) @db.Decimal(5,4)
  annualDays Decimal @default(0) @db.Decimal(8,2)
  carryForwardDays Decimal @default(0) @db.Decimal(8,2)
  requests LeaveRequest[]
  ledger LeaveLedger[]
  @@unique([tenantId,id])
  @@unique([tenantId,name])
}
model LeaveRequest {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  leaveTypeId String @db.Char(36)
  leaveType LeaveType @relation(fields:[tenantId,leaveTypeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  days Decimal @db.Decimal(8,2)
  paidFraction Decimal @default(1) @db.Decimal(5,4)
  reason String @db.Text
  status String @default("PENDING") @db.VarChar(16)
  submittedBy String @db.Char(36)
  approvedBy String? @db.Char(36)
  approvedAt DateTime?
  comment String? @db.Text
  payrollRunId String? @db.Char(36)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,employeeId,status])
}
model LeaveLedger {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  leaveTypeId String @db.Char(36)
  leaveType LeaveType @relation(fields:[tenantId,leaveTypeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  days Decimal @db.Decimal(8,2)
  parentId String? @db.Char(36)
  parent LeaveLedger? @relation("LedgerAllocation",fields:[tenantId,parentId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  allocations LeaveLedger[] @relation("LedgerAllocation")
  kind String @db.VarChar(32)
  reason String @db.Text
  actorId String @db.Char(36)
  sourceId String? @db.VarChar(100)
  effectiveDate DateTime @db.Date
  expiresAt DateTime? @db.Date
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,sourceId])
  @@index([tenantId,employeeId,leaveTypeId])
}
model Timesheet {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  workDate DateTime @db.Date
  shift String @db.VarChar(64)
  startsAt DateTime
  endsAt DateTime
  breakHours Decimal @db.Decimal(5,2)
  hours Decimal @db.Decimal(5,2)
  status String @default("PENDING") @db.VarChar(16)
  submittedBy String @db.Char(36)
  approvedBy String? @db.Char(36)
  approvedAt DateTime?
  comment String? @db.Text
  payrollRunId String? @db.Char(36)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,employeeId,workDate,shift])
}
model Overtime {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  workDate DateTime @db.Date
  hours Decimal @db.Decimal(5,2)
  multiplier Decimal @db.Decimal(5,2)
  category String @db.VarChar(64)
  reason String @db.Text
  status String @default("PENDING") @db.VarChar(16)
  submittedBy String @db.Char(36)
  approvedBy String? @db.Char(36)
  approvedAt DateTime?
  comment String? @db.Text
  payrollRunId String? @db.Char(36)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,employeeId,workDate])
  @@unique([tenantId,employeeId,workDate,category])
}
model PayrollAdjustment {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  name String @db.VarChar(100)
  kind String @db.VarChar(32)
  amount Decimal @db.Decimal(18,2)
  recurrence String @default("ONE_OFF") @db.VarChar(16)
  payrollRunId String? @db.Char(36)
  payrollRun PayrollRun? @relation(fields:[tenantId,payrollRunId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  taxable Boolean @default(true)
  taxRelief Boolean @default(false)
  reason String @db.Text
  effectiveDate DateTime @db.Date
  endDate DateTime? @db.Date
  createdBy String @db.Char(36)
  createdAt DateTime @default(now())
}
model StatutoryRule {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  name String @db.VarChar(100)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  configuration Json
  status String @default("DRAFT") @db.VarChar(16)
  runs PayrollRun[]
  components StatutoryComponent[]
  sourceReference String @db.Text
  referenceVectors Json?
  createdBy String @db.Char(36)
  approvedBy String? @db.Char(36)
  approvedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@index([tenantId,effectiveFrom,status])
}
model PayrollRun {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  frequency String @db.VarChar(16)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  payDate DateTime @db.Date
  revision Int @default(1)
  payGroup String @default("ALL") @db.VarChar(64)
  employeeSelection Json?
  preparationError String? @db.Text
  status String @default("DRAFT") @db.VarChar(16)
  ruleId String? @db.Char(36)
  rule StatutoryRule? @relation(fields:[tenantId,ruleId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  createdBy String @db.Char(36)
  preparedBy String? @db.Char(36)
  reviewedBy String? @db.Char(36)
  approvedBy String? @db.Char(36)
  approvedAt DateTime?
  reversalReason String? @db.Text
  version Int @default(1)
  inputDigest String? @db.Char(64)
  snapshots PayrollSnapshot[]
  adjustmentItems PayrollAdjustment[]
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,payGroup,frequency,startDate,endDate,revision])
}
model PayrollSnapshot {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  runId String @db.Char(36)
  run PayrollRun @relation(fields:[tenantId,runId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  employeeId String @db.Char(36)
  employee Employee @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  gross Decimal @db.Decimal(18,2)
  net Decimal @db.Decimal(18,2)
  deductions Decimal @db.Decimal(18,2)
  employerContributions Decimal @db.Decimal(18,2)
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
  @@unique([tenantId,runId,employeeId])
}
model Plan {
  id String @id @default(uuid()) @db.Char(36)
  code String @unique @db.VarChar(32)
  productId String? @db.Char(36)
  product Product? @relation(fields:[productId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  configuredFeatures PlanFeature[]
  name String @db.VarChar(100)
  price Decimal? @db.Decimal(18,2)
  currency String @default("JMD") @db.VarChar(3)
  durationDays Int?
  employeeLimit Int
  userLimit Int
  graceDays Int @default(0)
  features Json
  active Boolean @default(true)
  version Int @default(1)
  subscriptions Subscription[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Subscription {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @unique @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  planId String @db.Char(36)
  plan Plan @relation(fields:[planId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  status String @db.VarChar(16)
  startsAt DateTime @default(now())
  expiresAt DateTime?
  graceEndsAt DateTime?
  employeeLimit Int
  userLimit Int
  features Json
  codes ActivationCode[]
  license License?
  payments ManualPayment[]
  @@unique([tenantId,id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ManualPayment {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  amount Decimal @db.Decimal(18,2)
  currency String @db.VarChar(3)
  method String @db.VarChar(32)
  reference String @db.VarChar(191)
  invoiceNumber String @db.VarChar(100)
  paymentDate DateTime @db.Date
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  evidenceFileId String? @db.Char(36)
  status String @default("PENDING") @db.VarChar(16)
  recordedBy String @db.Char(36)
  verifiedBy String? @db.Char(36)
  verifiedAt DateTime?
  usedAt DateTime?
  subscriptionId String? @db.Char(36)
  subscription Subscription? @relation(fields:[tenantId,subscriptionId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  applicationKind String? @db.VarChar(16)
  reason String? @db.Text
  events PaymentEvent[]
  createdAt DateTime @default(now())
  @@unique([tenantId,reference])
}
model PaymentEvent {
  id String @id @default(uuid()) @db.Char(36)
  paymentId String @db.Char(36)
  payment ManualPayment @relation(fields:[paymentId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  actorId String @db.Char(36)
  status String @db.VarChar(16)
  reason String @db.Text
  createdAt DateTime @default(now())
}
model ActivationCode {
  id String @id @default(uuid()) @db.Char(36)
  hash String @unique @db.Char(64)
  subscriptionId String @db.Char(36)
  subscription Subscription @relation(fields:[tenantId,subscriptionId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  tenantId String @db.Char(36)
  payload Json
  expiresAt DateTime
  redeemedAt DateTime?
  issuedBy String @db.Char(36)
  createdAt DateTime @default(now())
}
model SubscriptionEvent {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  actorId String @db.Char(36)
  kind String @db.VarChar(64)
  details Json
  createdAt DateTime @default(now())
}
model AuditEvent {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String? @db.Char(36)
  tenant Tenant? @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  actorId String? @db.Char(36)
  action String @db.VarChar(100)
  scope String @default("TENANT") @db.VarChar(16)
  entityId String? @db.VarChar(100)
  details Json
  requestId String @db.Char(36)
  createdAt DateTime @default(now())
  @@index([tenantId,createdAt])
}
model PrivateFile {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  employeeId String? @db.Char(36)
  employee Employee? @relation(fields:[tenantId,employeeId],references:[tenantId,id],onDelete:Restrict,onUpdate:Cascade)
  reportJobs ReportJob[]
  kind String @default("DOCUMENT") @db.VarChar(32)
  retainUntil DateTime? @db.Date
  objectKey String @unique @db.VarChar(255)
  name String @db.VarChar(191)
  contentType String @db.VarChar(100)
  size Int
  scanStatus String @default("QUARANTINED") @db.VarChar(16)
  createdBy String @db.Char(36)
  createdAt DateTime @default(now())
  @@unique([tenantId,id])
}
model ImportBatch {
  id String @id @default(uuid()) @db.Char(36)
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  kind String @db.VarChar(32)
  status String @default("PREVIEW") @db.VarChar(16)
  actorId String @db.Char(36)
  rows ImportRow[]
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([tenantId,id])
}
model ImportRow {
  id String @id @default(uuid()) @db.Char(36)
  batchId String @db.Char(36)
  batch ImportBatch @relation(fields:[batchId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  rowNumber Int
  input Json
  status String @default("PENDING") @db.VarChar(16)
  error String? @db.Text
  entityId String? @db.Char(36)
  @@unique([batchId,rowNumber])
}
model LegacyMap {
  tenantId String @db.Char(36)
  tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Restrict,onUpdate:Cascade)
  sourceDigest String @default("") @db.Char(64)
  createdAt DateTime @default(now())
  source String @db.VarChar(64)
  legacyId String @db.VarChar(100)
  entityId String @db.Char(36)
  @@id([tenantId,source,legacyId])
}

model EmployeeBankAccount {
  id String @id @default(uuid()) @db.Char(36)
